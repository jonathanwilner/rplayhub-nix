+/* Parse [host:]port into host (default 127.0.0.1) and port. Returns 0 on success. */
+static int parse_host_port(const char *spec, char *host, size_t host_len, long *port_out)
+{
+    char copy[256];
+    if (strlen(spec) >= sizeof copy) return -1;
+    strcpy(copy, spec);
+    char *colon = strrchr(copy, ':');
+    if (!colon) {
+        *port_out = strtol(copy, NULL, 10);
+        snprintf(host, host_len, "127.0.0.1");
+        return 0;
+    }
+    *colon = 0;
+    if (copy[0] == '[') {
+        char *close = strchr(copy, ']');
+        if (!close) return -1;
+        *close = 0;
+        snprintf(host, host_len, "%s", copy + 1);
+    } else {
+        snprintf(host, host_len, "%s", copy);
+    }
+    *port_out = strtol(colon + 1, NULL, 10);
+    return 0;
+}
